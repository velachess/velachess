DATABASE_URL=postgresql://velachess:velachess@localhost:5434/velachess
REDIS_URL=redis://localhost:6380

# 32+ chars: openssl rand -base64 32
VELACHESS_AUTH_SECRET=change-me-to-a-random-32-character-secret

# Origin the browser is on: 5173 in dev, the public URL in production.
VELACHESS_BASE_URL=http://localhost:5173
# VELACHESS_TRUSTED_ORIGINS=http://127.0.0.1:5173

# Google sign-in, both or neither. Redirect URI: <VELACHESS_BASE_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend email (verification, password reset), both or neither.
# RESEND_API_KEY=
# VELACHESS_EMAIL_FROM=VelaChess <no-reply@chess.example.com>

# Reverse proxies in front of the API (addresses or CIDR); required behind one.
# VELACHESS_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Uploaded files; must be absolute in production.
# VELACHESS_STORAGE_DIR=.data/storage

# Worker liveness probe port.
# WORKER_HEALTH_PORT=3003

# First user, created once into an empty database. Remove after first login.
VELACHESS_BOOTSTRAP_USER_EMAIL=user@velachess.local
VELACHESS_BOOTSTRAP_USER_PASSWORD=dev-password
