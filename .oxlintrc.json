{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "drizzle/**",
    "**/*.d.ts"
  ],
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["react", "react-perf", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/prefer-tag-over-role": "warn",
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-jsx-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-object-as-prop": "off"
      }
    },
    {
      "files": [
        "**/*.test.{ts,tsx}",
        "**/__tests__/**/*.{ts,tsx}",
        "**/__e2e__/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-unused-vars": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["libs/chess/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/analysis", "@velachess/analysis/**"],
                "message": "libs/chess is a leaf rules package."
              },
              {
                "group": ["@velachess/db", "@velachess/db/**"],
                "message": "libs/chess is a leaf rules package."
              },
              {
                "group": ["@velachess/engine", "@velachess/engine/**"],
                "message": "libs/chess is a leaf rules package."
              },
              {
                "group": ["@velachess/platforms", "@velachess/platforms/**"],
                "message": "libs/chess is a leaf rules package."
              },
              {
                "group": ["@velachess/repertoire", "@velachess/repertoire/**"],
                "message": "libs/chess is a leaf rules package."
              },
              {
                "group": ["@velachess/scheduler", "@velachess/scheduler/**"],
                "message": "libs/chess is a leaf rules package."
              },
              {
                "group": ["@/app/**", "@/components/**", "@/features/**"],
                "message": "Packages must not depend on UI code. UI depends on packages, not the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/infra/engine/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/chess", "@velachess/chess/**"],
                "message": "libs/infra/engine talks UCI, nothing else \u2014 it must not depend on @velachess/chess."
              },
              {
                "group": ["@/app/**", "@/components/**", "@/features/**"],
                "message": "Packages must not depend on UI code. UI depends on packages, not the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/server", "@velachess/server/**"],
                "message": "Architecture: libs must not import apps. apps/server is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/worker", "@velachess/worker/**"],
                "message": "Architecture: libs must not import apps. apps/worker is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/web", "@velachess/web/**"],
                "message": "Architecture: libs must not import apps. apps/web is a composition root; it depends on libs, never the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/infra/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/server", "@velachess/server/**"],
                "message": "Architecture: libs must not import apps. apps/server is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/worker", "@velachess/worker/**"],
                "message": "Architecture: libs must not import apps. apps/worker is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/web", "@velachess/web/**"],
                "message": "Architecture: libs must not import apps. apps/web is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/application", "@velachess/application/**"],
                "message": "Architecture: infra is a technical mechanism and must not know application behavior. libs/application depends on libs/infra, never the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/server", "@velachess/server/**"],
                "message": "Architecture: libs must not import apps. apps/server is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/worker", "@velachess/worker/**"],
                "message": "Architecture: libs must not import apps. apps/worker is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/web", "@velachess/web/**"],
                "message": "Architecture: libs must not import apps. apps/web is a composition root; it depends on libs, never the reverse."
              },
              {
                "group": ["@velachess/application", "@velachess/application/**"],
                "message": "Architecture: packages/* is intentionally public code and must not leak private application internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/repertoire/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/engine", "@velachess/engine/**"],
                "message": "libs/repertoire compares position trees, not evaluations \u2014 it must not talk UCI."
              },
              {
                "group": ["@velachess/platforms", "@velachess/platforms/**"],
                "message": "libs/repertoire has no I/O \u2014 it must not depend on @velachess/platforms."
              },
              {
                "group": ["@velachess/db", "@velachess/db/**"],
                "message": "libs/repertoire has no I/O \u2014 it must not depend on @velachess/db."
              },
              {
                "group": ["@/app/**", "@/components/**", "@/features/**"],
                "message": "Libs must not depend on UI code. UI depends on libs, not the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/infra/platforms/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/engine", "@velachess/engine/**"],
                "message": "libs/infra/platforms fetches and normalizes games \u2014 it must not talk UCI."
              },
              {
                "group": ["@/app/**", "@/components/**", "@/features/**"],
                "message": "Libs must not depend on UI code. UI depends on libs, not the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/infra/platforms/providers/chess-com.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "libs/infra/engine/session.ts",
        "libs/infra/engine/transport-worker.ts",
        "libs/infra/engine/__tests__/fake-transport.ts"
      ],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["libs/infra/db/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@velachess/engine", "@velachess/engine/**"],
                "message": "libs/infra/db persists games \u2014 it has no reason to talk UCI."
              },
              {
                "group": ["@velachess/chess", "@velachess/chess/**"],
                "message": "libs/infra/db persists what providers already normalized \u2014 it must not depend on @velachess/chess."
              },
              {
                "group": ["@velachess/application", "@velachess/application/**"],
                "message": "Architecture: infra is a technical mechanism and must not know application behavior."
              },
              {
                "group": ["@/app/**", "@/components/**", "@/features/**"],
                "message": "Libs must not depend on UI code. UI depends on libs, not the reverse."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/infra/db/__tests__/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "node": true
  }
}
