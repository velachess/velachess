{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // TanStack Router consumes each file-route `Route` export by filename
  // convention during Vite route generation; there is no normal import edge.
  "ignoreIssues": {
    "apps/web/src/routes/**/*.tsx": ["exports"]
  },
  "workspaces": {
    // Routes are real entry points the router finds on the filesystem, not
    // through an import — the gitignored, generated `routeTree.gen` import
    // is unresolved in CI, so without this every screen reads as dead.
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "lingui.config.ts", "**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/site": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        // Next resolves the custom image loader from a config string.
        "src/landing/image-loader.ts",
        "lingui.config.ts",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      // Referenced by string from Next/PostCSS configuration and imported CSS.
      "ignoreDependencies": ["@lingui/swc-plugin", "tailwindcss"]
    },
    "libs/chess": {
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "libs/fixtures": {
      "project": ["**/*.{ts,tsx}"]
    },
    "libs/infra/engine": {
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "libs/infra/platforms": {
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "libs/infra/db": {
      "entry": ["**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "libs/infra/email": {
      "entry": ["lingui.config.ts", "**/*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
