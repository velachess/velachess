{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // `process.env.FOO` is an index access wearing a property's clothes:
    // it types as string when it can be undefined. These make that visible.
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@velachess/ui/*": ["./libs/ui/src/*"],
      "@velachess/chess": ["./libs/chess/index.ts"],
      "@velachess/chess/*": ["./libs/chess/*"],
      "@velachess/engine": ["./libs/infra/engine/index.ts"],
      "@velachess/engine/*": ["./libs/infra/engine/*"],
      "@velachess/fixtures": ["./libs/fixtures/index.ts"],
      "@velachess/fixtures/*": ["./libs/fixtures/*"],
      "@velachess/platforms": ["./libs/infra/platforms/index.ts"],
      "@velachess/platforms/*": ["./libs/infra/platforms/*"],
      "@velachess/logger": ["./libs/infra/logger/src/index.ts"],
      "@velachess/logger/*": ["./libs/infra/logger/src/*"],
      "@velachess/db": ["./libs/infra/db/index.ts"],
      "@velachess/db/*": ["./libs/infra/db/*"],
      "@velachess/analysis": ["./libs/analysis/index.ts"],
      "@velachess/analysis/*": ["./libs/analysis/*"],
      "@velachess/repertoire": ["./libs/repertoire/index.ts"],
      "@velachess/scheduler": ["./libs/scheduler/index.ts"],
      "@velachess/scheduler/*": ["./libs/scheduler/*"],
      "@velachess/repertoire/*": ["./libs/repertoire/*"],
      "@velachess/queue": ["./libs/infra/queue/index.ts"],
      "@velachess/queue/*": ["./libs/infra/queue/*"],
      "@velachess/auth": ["./libs/infra/auth/index.ts"],
      "@velachess/auth/*": ["./libs/infra/auth/*"],
      "@velachess/application": ["./libs/application/index.ts"],
      "@velachess/application/*": ["./libs/application/*"],
      "@velachess/test-utils": ["./libs/test-utils/index.ts"],
      "@velachess/test-utils/*": ["./libs/test-utils/*"]
    }
  },
  "include": [
    "libs/**/*.ts",
    "libs/**/*.tsx",
    "libs/**/*.mts",
    "apps/**/*.ts",
    "__tests__/**/*.ts",
    "__e2e__/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "apps/web", "apps/site"]
}
