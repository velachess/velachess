{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // `process.env.FOO` is an index access wearing a property's clothes:
    // it types as string when it can be undefined. These make that visible.
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@velachess/ui/*": ["./libs/ui/src/*"],
      "@velachess/chess": ["./libs/chess/index.ts"],
      "@velachess/chess/*": ["./libs/chess/*"],
      "@velachess/infra-engine": ["./libs/infra/engine/index.ts"],
      "@velachess/infra-engine/*": ["./libs/infra/engine/*"],
      "@velachess/fixtures": ["./libs/fixtures/index.ts"],
      "@velachess/fixtures/*": ["./libs/fixtures/*"],
      "@velachess/infra-platforms": ["./libs/infra/platforms/index.ts"],
      "@velachess/infra-platforms/*": ["./libs/infra/platforms/*"],
      "@velachess/infra-logger": ["./libs/infra/logger/src/index.ts"],
      "@velachess/infra-logger/*": ["./libs/infra/logger/src/*"],
      "@velachess/infra-db": ["./libs/infra/db/index.ts"],
      "@velachess/infra-db/*": ["./libs/infra/db/*"],
      "@velachess/analysis": ["./libs/analysis/index.ts"],
      "@velachess/scheduler": ["./libs/scheduler/index.ts"],
      "@velachess/scheduler/*": ["./libs/scheduler/*"],
      "@velachess/infra-queue": ["./libs/infra/queue/index.ts"],
      "@velachess/infra-queue/*": ["./libs/infra/queue/*"],
      "@velachess/infra-auth": ["./libs/infra/auth/index.ts"],
      "@velachess/infra-auth/*": ["./libs/infra/auth/*"],
      "@velachess/accounts": ["./libs/accounts/index.ts"],
      "@velachess/overview": ["./libs/overview/index.ts"],
      "@velachess/deviations": ["./libs/deviations/index.ts"],
      "@velachess/drills": ["./libs/drills/index.ts"],
      "@velachess/games": ["./libs/games/index.ts"],
      "@velachess/insights": ["./libs/insights/index.ts"],
      "@velachess/repertoires": ["./libs/repertoires/index.ts"],
      "@velachess/auth": ["./libs/auth/index.ts"],
      "@velachess/test-utils": ["./libs/test-utils/index.ts"],
      "@velachess/test-utils/*": ["./libs/test-utils/*"]
    }
  },
  "include": [
    "libs/**/*.ts",
    "libs/**/*.tsx",
    "libs/**/*.mts",
    "apps/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules", "apps/web", "apps/site"]
}
